# Optional overrides for `docker compose` (copy to .env). All have development defaults.
# POSTGRES_PASSWORD=postgres-dev
# AUTH_DB_PASSWORD=auth-dev
# FLEET_DB_PASSWORD=fleet-dev
# STATION_DB_PASSWORD=station-dev
# PAYMENT_DB_PASSWORD=payment-dev
# FUELING_DB_PASSWORD=fueling-dev
# VALKEY_PASSWORD=valkey-dev
# RABBITMQ_USER=petro
# RABBITMQ_PASSWORD=petro-dev
# DEMO_MODE=true            # one-tap demo sign-in
# DEMO_PASSWORD=demo1234
# SEED_DEMO_DATA=true       # seed the prototype's demo data
# ACCESS_TOKEN_TTL=8h
# AUTH_SIGNING_KEY=         # PEM Ed25519 key; empty = ephemeral key (sessions end on auth restart)
# LOG_LEVEL=info
