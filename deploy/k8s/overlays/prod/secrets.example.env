# Keys of the "petro-secrets" Secret (namespace petro). Values are examples.
# Create it from your secret manager, or for a quick start:
#   kubectl -n petro create secret generic petro-secrets --from-env-file=secrets.env \
#     --from-file=auth-signing-key=auth-signing-key.pem
# Generate the signing key once and keep it: openssl genpkey -algorithm ed25519 -out auth-signing-key.pem
auth-database-url=postgres://auth:CHANGE_ME@db.internal:5432/auth?sslmode=require
fleet-database-url=postgres://fleet:CHANGE_ME@db.internal:5432/fleet?sslmode=require
station-database-url=postgres://station:CHANGE_ME@db.internal:5432/station?sslmode=require
payment-database-url=postgres://payment:CHANGE_ME@db.internal:5432/payment?sslmode=require
fueling-database-url=postgres://fueling:CHANGE_ME@db.internal:5432/fueling?sslmode=require
amqp-url=amqps://petro:CHANGE_ME@mq.internal:5671/
valkey-password=CHANGE_ME
demo-password=unused-in-production
# auth-signing-key: PEM (PKCS#8 Ed25519), added with --from-file above.
